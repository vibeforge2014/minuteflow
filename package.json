{
  "name": "minuteflow",
  "productName": "MinuteFlow",
  "version": "0.1.14",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:renderer": "vite build",
    "start": "electron .",
    "package": "npm run build:renderer && electron-forge package",
    "make": "npm run build:renderer && electron-forge make",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/meeting-core.test.ts",
    "test:watch": "vitest",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@fugood/whisper.node": "^1.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tiptap/extension-placeholder": "^3.0.7",
    "@tiptap/react": "^3.0.7",
    "@tiptap/starter-kit": "^3.0.7",
    "docx": "^9.5.1",
    "dompurify": "^3.4.12",
    "jszip": "^3.10.1",
    "marked": "^18.0.7",
    "opencc-js": "^1.4.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "turndown": "^7.2.4",
    "zod": "^4.0.14",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-dmg": "^7.8.1",
    "@electron-forge/maker-squirrel": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.1",
    "@electron-forge/plugin-fuses": "^7.8.1",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "43.2.0",
    "typescript": "^5.9.2",
    "vite": "6.4.2",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "^1.13.4"
  }
}
