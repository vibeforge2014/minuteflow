{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "electron/**/*.mjs",
    "electron/**/*.cjs",
    "scripts/**/*.mjs",
    "forge.config.mjs",
    "vite.config.mjs",
    "vitest.config.mjs"
  ],
  "exclude": ["dist", "node_modules", ".build", "out"]
}
