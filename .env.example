# 本地签名 / 公证所需的环境变量（复制为 .env 后 Electron Forge 不会自动加载，
# 运行 `npm run make` 前请手动 source 或在命令前导出；本文件不含任何机密值）。
#
# —— 代码签名（Developer ID）——
# 证书 CN 来自本机登录钥匙串里已安装的 "Developer ID Application: Zhen Qian (LPW4Z3BN69)"。
# 未设置时退化为 ad-hoc 开发构建（不可对外分发）。
APPLE_IDENTITY=Developer ID Application: Zhen Qian (LPW4Z3BN69)

# —— 公证（App Store Connect API Key，非机密标识符）——
# 以下两项已内置于 forge.config.mjs 默认值，可省略；仅列出以便理解。
APPLE_API_KEY_ID=496SRK4K68
APPLE_API_ISSUER=a307ff7b-774c-4ef6-98c4-8031876fa556

# .p8 密钥文件的「路径」（不是内容）。本地指向凭证目录里的实体文件即可。
# 注意：这是机器专属路径，请勿写死进仓库；CI 由 build-desktop.yml 从 secret 生成。
APPLE_NOTARY_KEY_PATH=/Users/zqian15/Desktop/apple app凭证/AuthKey_496SRK4K68.p8

# —— 开关 ——
# 设为 1 时，本地 `npm run make` 也会对产物做公证 + 装订（会真实上传至 Apple 并等待）。
# 常规本地构建保持为空，只做 Developer ID 签名、不上传公证。
MINUTEFLOW_NOTARIZE=
